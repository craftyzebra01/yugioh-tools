{
  "name": "yugioh-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Yu-Gi-Oh! tooling — Card Pull Matcher and shared card data ingest",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx scripts/serve.ts",
    "serve": "tsx scripts/serve.ts",
    "ingest": "tsx scripts/ingest.ts",
    "refresh": "tsx scripts/refresh.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
